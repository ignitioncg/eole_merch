{
  "name": "eole-stock-catalog",
  "version": "1.0.0",
  "description": "Private monday.com app for End of Life Essentials: Custom Object portal for merchandise stock and orders, with bidirectional sync to existing boards and a Stock Movements audit board.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm test --workspace server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dryrun": "node scripts/dryrun.js",
    "deploy:client": "mapps code:push -c -d client/dist",
    "deploy:server": "mapps code:push -d server"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "uuid": "^14.0.0",
    "gaxios": "^7.1.4",
    "http-proxy-agent": "^9.0.0",
    "retry-request": "^8.0.2",
    "teeny-request": "^10.1.2"
  }
}
